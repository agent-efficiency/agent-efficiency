{
  "description": "Fast, local Agent Efficiency lifecycle governance for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${PLUGIN_ROOT}/scripts/agent_efficiency_hook.py\"",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
